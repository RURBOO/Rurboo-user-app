# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Google Maps API Key
# Get from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Configuration (Optional - using google-services.json instead)
# But if you need them for web or other platforms:
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_APP_ID=your_firebase_app_id

# Environment
ENV=development
# Options: development, staging, production

# API Base URL (if you have custom backend)
API_BASE_URL=https://api.rurboo.com

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_DEBUG_LOGGING=true

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMS Gateway (MSG91/Twilio)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=RURBOO

# App Version
APP_VERSION=1.0.0
BUILD_NUMBER=1
