rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Users can read/write their own profile
      allow read, write: if isOwner(userId);
    }

    // DRIVERS COLLECTION
    match /drivers/{driverId} {
      // Drivers manage their own data
      allow write: if isOwner(driverId);
      // Authenticated users can read driver profiles (for booking)
      allow read: if isAuthenticated();
    }

    // RIDES COLLECTION
    match /rides/{rideId} {
      // Users can create rides
      allow create: if isAuthenticated();
      // Riders and Drivers can read/update the ride they are involved in
      allow read, update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.driverId == request.auth.uid
      );
    }

    // HISTORY/TRANSACTIONS
    match /history/{historyId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.driverId == request.auth.uid
      );
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
